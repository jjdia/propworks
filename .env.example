# Copy this file to .env for local dev, and add the same two values as
# repository secrets (Settings -> Secrets and variables -> Actions) named
# exactly VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY so the GitHub Pages
# build picks them up. NEVER put the service_role key here or anywhere in
# this repo - only the public anon/publishable key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# V 34 Web Push: the VAPID PUBLIC key only (generate with
# `node scripts/generate-vapid-keys.mjs`). Also add it as repo secret
# VITE_VAPID_PUBLIC_KEY. The PRIVATE key goes only in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=
